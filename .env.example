# ==============================================================================
# QuarkShield.ai Desktop & Enterprise PQC Scanner Configuration
# ==============================================================================

# Server & Network Settings
PORT=5050
HTTPS_PORT=5443
NODE_ENV=production
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://quarkshield.ai,https://scanner.quarkshield.ai,https://app.quarkshield.ai
# COOKIE_DOMAIN: Apex domain cookie scope so session survives apex -> subdomain redirects (omit for localhost)
COOKIE_DOMAIN=.quarkshield.ai
# Optional custom host URL for agent downloads and payloads
APP_HOST_URL=https://quarkshield.ai
# SERVER_PUBLIC_URL=https://scanner.quarkshield.ai

# Database Settings (PostgreSQL 14+)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=scanner-db
DB_PORT=5432
DB_DATABASE=quarkshield_scanner

# Mandatory Security & Cryptographic Secrets (REQUIRED in production, minimum 32 chars)
# Generate random 32-byte hex strings via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-secure-random-64-character-jwt-signing-secret
LICENSE_SIGNING_SECRET=replace-with-secure-random-64-character-license-hmac-secret

# Optional Specialized Encryption Secrets (defaults fall back to JWT_SECRET if unset)
TWO_FACTOR_ENC_KEY=replace-with-secure-256bit-totp-encryption-key
CONNECTOR_ENC_KEY=replace-with-secure-256bit-cloud-vault-encryption-key
CBOM_SIGNING_SECRET=replace-with-secure-cdxa-attestation-signing-secret

# Emergency Super Administrator Bootstrap (Created on initial DB setup if not present)
BOOTSTRAP_ADMIN_EMAIL=root@quarkshield.ai
BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-bootstrap-password

# Email & Notifications (Resend API)
RESEND_API_KEY=re_...
SMTP_FROM=QuarkShield Licensing <license@quarkshield.ai>

# Commercial Billing (Stripe Integration)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Cryptographic Copilot (Optional)
# GEMINI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...
